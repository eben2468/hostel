<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /hostel/public/

    # Serve existing files/directories directly (assets, uploads).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block direct access to uploaded PHP (defense in depth)
<FilesMatch "\.(php|phtml)$">
    <If "%{REQUEST_URI} =~ m#/uploads/#">
        Require all denied
    </If>
</FilesMatch>
